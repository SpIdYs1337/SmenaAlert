# Скопируйте в .env.web. Вход в панель защищён логином и паролем.
PANEL_ADMIN_LOGIN=admin
PANEL_ADMIN_PASSWORD=replace-with-a-strong-password

# Порт на хосте и интерфейс публикации. По умолчанию панель слушает только localhost.
PANEL_PORT=8080
PANEL_BIND=127.0.0.1
# Установите 1, если панель открывается через HTTPS.
PANEL_SECURE_COOKIE=0
